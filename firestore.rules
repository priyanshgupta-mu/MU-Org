rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Who may edit the org chart:
    //   owners          — fixed here, always admins, can give and take access
    //   access managers — fixed here, same powers as owners
    //   everyone else   — a doc at /admins/{email}, added or removed from the
    //                     admin panel's "Manage access" by an owner or manager
    // Owners and managers live here rather than in the collection so nobody can
    // lock them out from the panel. Change them here and redeploy:
    //   npm run deploy:rules
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function canGrant() {
      return signedIn() && email() in [
        'salil.narkar1@mastersunion.org',
        'priyansh.gupta@mastersunion.org',
        'mahima.mahur@mastersunion.org',
        'anurag.mahor@mastersunion.org'
      ];
    }
    function isAdmin() {
      return canGrant()
        || (signedIn() && exists(/databases/$(database)/documents/admins/$(email())));
    }

    function validPerson() {
      let d = request.resource.data;
      return d.keys().hasOnly(['code', 'name', 'title', 'dept', 'bu', 'subDept', 'managerId', 'empType', 'kras'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.title is string && d.title.size() <= 300
        && d.dept is string && d.dept.size() > 0 && d.dept.size() <= 40
        && d.empType is string && d.empType.size() > 0 && d.empType.size() <= 40
        && (!('code' in d) || (d.code is string && d.code.size() <= 40))
        && (!('bu' in d) || (d.bu is string && d.bu.size() <= 120))
        && (!('subDept' in d) || (d.subDept is string && d.subDept.size() <= 120))
        && (!('managerId' in d) || (d.managerId is string && d.managerId.size() <= 60))
        && (!('kras' in d) || (d.kras is list && d.kras.size() <= 40));
    }

    // The org chart is public, so anyone may read the roster.
    // Only listed admins may change it.
    match /people/{personId} {
      allow read: if true;
      allow create, update: if isAdmin() && validPerson() && personId.size() <= 60;
      allow delete: if isAdmin();
    }

    // The admin list. Anyone signed in may check their own entry (that is how
    // the panel decides whether to let them in); admins may see the whole list.
    match /admins/{adminEmail} {
      allow read: if isAdmin() || (signedIn() && email() == adminEmail);
      allow create, update: if canGrant()
        && adminEmail == adminEmail.lower()
        && adminEmail.matches('^[^@\\s/]+@[^@\\s/]+[.][a-z]{2,}$')
        && request.resource.data.keys().hasOnly(['addedBy', 'addedAt'])
        && request.resource.data.addedBy == email()
        && request.resource.data.addedAt == request.time;
      allow delete: if canGrant();
    }
  }
}
